# ポート番号（通常は変更不要）
PORT=3000

# 管理者パスワード
ADMIN_PW=735657

# Google Apps Script の URL（各拠点のウェブアプリURLを設定してください。
# 未設定のままではスプレッドシート同期・メール送信は無効になります）
# GAS_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# SYNC_TOKEN は初回起動時に自動生成されます。設定不要。
# GASとのペアリングは、GAS側で resetSyncPairing() を実行するだけで自動完了します。

# Arduinoのシリアルポート（自動検出されない場合のみ指定）
# SERIAL_PORT=/dev/ttyACM0

# 同期間隔（ミリ秒、既定: 3分）
# SYNC_INTERVAL_MS=180000

# バックアップ設定（既定: 6時間ごと、30日 or 60件で古いものを削除）
# BACKUP_INTERVAL_MS=21600000
# BACKUP_RETENTION_DAYS=30
# BACKUP_MAX_COUNT=60

# 外部ストレージの保存先（自動検出されない場合のみ指定）
# EXTERNAL_STORAGE_DIR=/mnt/usb/data
