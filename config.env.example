# このファイルを config.env という名前でコピーして値を編集してください。
# （config.env は .gitignore 済みにしておくことを推奨します）

# サーバーのポート番号（変更しなければ 3000）
PORT=3000

# Arduino のシリアルポート。
# 通常は指定不要（コメントアウトのまま）にしてください。指定しない場合、
# 起動時にArduino(公式ボード)を自動検出して接続します。
# 自動検出は、公式Arduino(0x2341)に加えて、最も一般的な互換クローン基板
# (CH340=0x1a86 / CP2102=0x10c4 / FTDI=0x0403 など)も対象です。
# 自動検出がうまくいかない場合や、複数のArduinoらしきデバイスが同時に
# 接続されている環境でのみ、以下のコメントを外してポート名を指定してください
# （確認方法: Linux= ls /dev/ttyACM* /dev/ttyUSB* 、Windows= デバイスマネージャーで
#  「ポート(COMとLPT)」を確認。例: COM3）。
# ・Linux でポートは存在するのに「未接続」になる場合は、dialoutグループへの
#   登録が必要です: sudo usermod -aG dialout $(whoami) → ログアウト→再ログイン
# SERIAL_PORT=/dev/ttyACM0

# 管理者パスワード（初回ログイン後、変更を完了するまで管理画面はロックされます）
# ADMIN_PW=735657
ADMIN_PW=735657

# Google Apps Script の URL（既定URLから変更する場合に上書き）
GAS_URL=https://script.google.com/macros/s/AKfycbyiLKE52vvcBKSUbJ5eihTrLOvr-eaO5_Ncr6por_Mypw2CCExBK2g1tU5FlN45Gvmt/exec

# SMTP設定は不要になりました
# ------------------------------------------------------------------
# 貸出確認・返却確認メール（生徒本人宛）は、スプレッドシート同期と同じ
# Google Apps Script(GAS)経由で、GoogleアカウントのMailApp機能を使って
# 送信されます。SMTPサーバーやアプリパスワードの個別設定は不要です。
# GAS_URLとSYNC_TOKEN（後述、自動生成）が使えていれば自動的に有効になります。

# スプレッドシートへの同期(ローカルDB→GASミラー同期)について
# ------------------------------------------------------------------
# 同期用のトークン(SYNC_TOKEN)は、このファイルで設定する必要はありません。
# server.jsの初回起動時に自動生成され、このconfig.envに追記・保存されます。
# GASは初回リクエストによる自動ペアリングをしません。連携を使う場合は、
# 生成後にGASのスクリプトプロパティへ同じSYNC_TOKENを事前登録してください。
# GAS_URLが空欄・未設定の場合は上記の既定URLを使用します。
#
# 【端末を交換するなどトークンを変更するとき】
# config.envとGASのスクリプトプロパティを、管理者が同時に更新してください。

# 同期の実行間隔(ミリ秒)。既定は3分。頻繁に変える必要はありません
# SYNC_INTERVAL_MS=180000

# ローカルDB(貸出履歴・ブラックリスト等)の自動バックアップ設定。
# スプレッドシート同期が使えない状況でも、この機能だけでデータ保全ができる。
# 既定値: 6時間おきに実行、30日 or 60件を超えた古いバックアップは自動削除
# BACKUP_INTERVAL_MS=21600000
# BACKUP_RETENTION_DAYS=30
# BACKUP_MAX_COUNT=60

# 外部ストレージ（USBメモリ・SDカード）への自動保存
# ------------------------------------------------------------------
# 録画データ・DBバックアップ・設定バックアップの保存先は、外部USB/SDが
# 差し込まれた状態では自動的に外部へ、無い場合は内部ストレージへ切り替わります
# （サーバーは30秒ごとにUSB/SDを監視し、差し込み・取り外しに追従します）。
#
# ・外部が取り外された間は「内部ストレージ」に自動で保存を続けます。
# ・外部が再度差し込まれたら、その間に内部へ退避されたデータ（録画・
#   DBバックアップ・設定バックアップ）を自動で外部へ移行します。
#   - 移行に失敗したデータは内部に残り、次の監視タイミングで再試行します。
#   - 書き込み・変換中の録画は完了してから移行します。
#   - コピー先に既に同じものがある場合はスキップします。
#   - 外部使用中でも、以前内部で録画した映像は管理画面から閲覧できます。
#
# 明示指定した EXTERNAL_STORAGE_DIR / SD_CARD_PATH はそのパスを使用します。
# 自動検出するUSB/SDは、ルートに .device-lending-storage があるものだけです。
# 検出対象（優先順）:
#   1. EXTERNAL_STORAGE_DIR（この項目で明示指定した場合、これを最優先で使う）
#   2. SD_CARD_PATH（従来の固定SDパス / 既定: /mnt/shared/removable/SD/）
#   3. /media ・ /run/media 配下にマウントされたUSB・SD
#   4. Linux環境では lsblk で見つけたUSB/MMCのマウント
#   5. Windows開発環境ではUSBメモリ（ドライブレター）
# 管理者画面の「録画データ」「バックアップ」タブに現在の保存先が表示されます。
# 通常は何も設定せず自動検出で構いません。
# 特定のパスを最優先で使いたい場合のみ、以下の例のように指定してください。
# EXTERNAL_STORAGE_DIR=/mnt/usb/data
